PUBLIC_APP_URL=http://localhost/asociadosAnafinet
BASE_URL=/asociadosAnafinet

DB_HOST=localhost
DB_PORT=3306
DB_NAME=anafinet_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=anafinet_session
SESSION_TTL=86400

ALLOW_DEMO_LOGIN=0
DEMO_EMAIL=
DEMO_PASSWORD=

MERCADOPAGO_ACCESS_TOKEN=APP_USR-REEMPLAZA_CON_TU_ACCESS_TOKEN
MERCADOPAGO_WEBHOOK_SECRET=REEMPLAZA_CON_TU_WEBHOOK_SECRET
MERCADOPAGO_USE_SANDBOX=1
MEMBERSHIP_FEE_AMOUNT=1500.00
MEMBERSHIP_FEE_CURRENCY=MXN
MEMBERSHIP_FEE_LABEL=Membresia Anafinet

# Opcional en hosting compartido/cPanel si quieres almacenar uploads fuera del web root.
# UPLOADS_DIR=/home/usuario/private_uploads/anafinet
