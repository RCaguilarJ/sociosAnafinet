Options -Indexes
AddType image/avif .avif

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\.(?!well-known/) - [F,L,NC]
RewriteRule ^(?:database|scripts|vendor)/ - [F,L,NC]
</IfModule>

<FilesMatch "(^\.|composer\.(json|lock)$|package(-lock)?\.json$|.*\.(sql|bak|log|ini|ps1|sh|dist|yml|yaml|env))$">
    Require all denied
</FilesMatch>
